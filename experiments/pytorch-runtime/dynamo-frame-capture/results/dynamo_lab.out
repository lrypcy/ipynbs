        # File: /var/folders/1h/x16wsv8n5lgf2wz_nlgjjv340000gn/T/ipykernel_41819/1078170853.py:9 in model, code: return y * 2
        mul: "f32[8, 32]" = y_1 * 2;  y_1 = None
        return (mul,)
        
